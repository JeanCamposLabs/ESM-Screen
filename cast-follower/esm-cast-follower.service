[Unit]
Description=ESM cast follower (Google speakers follow the ESM screen config)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit: the user that has pychromecast installed, the path, and the speaker/group name.
User=pi
WorkingDirectory=/home/pi/esm-cast-follower
ExecStart=/usr/bin/python3 /home/pi/esm-cast-follower/cast_follower.py --device "Office speakers"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
